# ══════════════════════════════════════════════════════════════════════════
#  BOSS SMC BOT v2.1 — .env template
#  Copy this file to  %USERPROFILE%\.boss-bot\.env  (Windows)  or
#  ~/.boss-bot/.env  (Linux/macOS) and fill it in THERE - outside the repo, so
#  `git add .` can never pick it up. (Legacy: a ".env" next to main.py still
#  works and is git-ignored. $BOT_ENV_FILE can point anywhere.)
#  This template holds placeholders only; real values never go in the repo.
#
#  QUICK START (Windows):
#    1. git pull                          # get the code
#    2. install.bat                       # venv + packages, creates the secrets
#                                         # file outside the repo, turns on the
#                                         # commit-time secret scanner
#    3. fill section 1 below              # 3 lines = enough to run
#    4. venv\Scripts\python.exe preflight.py     # says READY, or what to fix
#    5. run_bot_forever.bat               # trades + auto-restarts + AI worker
#
#  Everything left out falls back to the tested default in config.py.
#  Values here are re-read on every restart, never mid-session.
# ══════════════════════════════════════════════════════════════════════════

# ── 1) REQUIRED — your MT5 account ───────────────────────────────────────
# Start on a DEMO account. The repo's own research (REAL_WORLD_TEST.md) says
# 2-3 months of demo, comparing live fills against the backtest, before real
# money. MT5_LOGIN must be numeric: the bot logs in itself, it does not reuse
# whatever the terminal happens to be showing.
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# ── 2) WHAT IT TRADES ───────────────────────────────────────────────────
# "m" suffix = Exness metal/crypto suffix; change to your broker's suffixes,
# or the symbol will be reported as "not found" by preflight.
SYMBOLS=XAUUSDm,EURUSDm,GBPUSDm,BTCUSDm

# balanced   = this repo's validated settings (cost-aware, filters on)
# ultra_fast = the old v2.0 speed profile (permissive filters) — demo only
BOT_PROFILE=balanced
# scalper    = fast M1 scalping + an AI lane built for speed (v2.2): 0.3s loop,
#              4s AI timeout, 3s per-entry AI budget (a silent AI never costs
#              you the entry - the bot trades its own signal; a real AI REJECT
#              is still final), position review every 15s with 1 vote.
#              v2.3 adds the twin-brain: an Analyst AI that reads the chart
#              itself, $-target scalping and a local Scalp Guard (see 4d).
#              Loose loss limits (25% daily / 40% drawdown): DEMO FIRST.
#              To use it:  BOT_PROFILE=scalper   (engine becomes SMC_MTF)

# SR_H1 = duel winner (PF 1.15 after real spread) | SMC_MTF = PF 0.93 (loses)
# FLASH = no measured edge (PF 0.67-0.78), experiment only
# Leave ENTRY_ENGINE commented out: each profile picks its own (balanced=SR_H1,
# scalper=SMC_MTF). A value written here OVERRIDES the profile - with
# BOT_PROFILE=scalper, ENTRY_ENGINE=SR_H1 would silently turn the fast M1
# scalper into an hourly swing bot.
#ENTRY_ENGINE=SR_H1

# ── 3) RISK — the part that decides whether you survive ─────────────────
# The values below are the BALANCED defaults, commented out on purpose: every
# profile (balanced / ultra_fast / scalper) ships its own tuned numbers, and a
# value you uncomment here overrides the profile. Uncomment only what you mean
# to change.
LOT_SIZE=0.01
#RISK_PERCENT_PER_TRADE=0.5      # % of equity risked per trade
#MAX_POSITIONS=2
#MAX_SPREAD=0.05                 # % of price; gold at 0.05% of 4000 = $2.00 cap
#MAX_SPREAD_COST_PCT=18.0        # refuse a trade whose spread is >18% of the stop.
                                # This single gate is the difference between the
                                # losing M1 config (11%) and the winning H1 one (4%).
                                # Set 0 to disable (not recommended).
#BREAK_EVEN_PROGRESS=0.45        # move SL to entry at 45% of the way to TP
ENABLE_BUY=true
ENABLE_SELL=true

# ── 4) AI — three independent roles ────────────────────────────────────
# Each role runs only when its own flag is true AND plumbing exists
# (AI_PROVIDER + a key). A flag that cannot run is reported loudly at startup
# instead of dying silently like v2.0 did.
#
#   role 1  AI_ENABLED          entry gate      APPROVE/REJECT/WAIT  fail-CLOSED
#   role 2  AI_POSITION_ENABLED position manager HOLD/CLOSE/EXTEND   fail-SAFE
#   role 3  AI_REGIME_ENABLED   bot directives    13 clamped params, expires
#
# Fail-closed (role 1) means: no usable AI verdict => no NEW trade. Open
# positions keep being protected by break-even/trailing either way.
AI_ENABLED=true
AI_POSITION_ENABLED=true
AI_REGIME_ENABLED=true

# provider + keys. "openai_compat" = OpenAI, Groq, Together, OpenRouter or a
# local /v1 server. Several keys are rotated on rate limits — add a 2nd key if
# you run 4 symbols.
AI_PROVIDER=openai_compat
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEYS=sk-key-1,sk-key-2
AI_MODEL=gpt-4o-mini
AI_RESPONSE_FORMAT=json_object

# A second, stronger brain: it hears a REJECT once (appeal) and it second-votes
# every EXTEND. Leave empty to use AI_MODEL for everything.
AI_POSITION_MODEL_2=
AI_REGIME_MODEL=

# ── 4b) AI ⇄ bot timing (v2.1: the AI never blocks the 0.5s loop) ───────
# (profile-dependent values are commented out - see the note in section 3)
AI_ASYNC=true                   # false = old inline behaviour (demo only)
#AI_WORKER_THREADS=1
AI_QUEUE_MAX=12                 # extra work is refused (fail-closed)
AI_QUEUE_BACKOFF_SECONDS=10     # ...and the scan backs off, no hammering
AI_RESULT_TTL_SECONDS=120
#AI_ENTRY_MAX_AGE_SECONDS=45     # a verdict older than this cannot open a trade
#AI_ENTRY_MAX_DRIFT_ATR=0.5      # price moved >0.5 ATR since the AI saw it => drop
AI_POSITION_MAX_DRIFT_PROGRESS=0.15
#AI_REJECT_COOLDOWN_SECONDS=45   # after a REJECT, stop re-asking every bar
# What happens when the AI has NOT answered yet (v2.2). The scalper profile
# defaults to proceed + 3s; the other profiles default to block (v2.1 contract).
#   block   = no verdict = no trade
#   proceed = after AI_ENTRY_BUDGET_SECONDS of silence (or an AI error / open
#             circuit / full queue) the bot trades its own signal; every risk
#             gate still runs, and a real REJECT is never overridden.
#AI_ENTRY_TIMEOUT_MODE=proceed
#AI_ENTRY_BUDGET_SECONDS=3.0
#AI_POSITION_INTERVAL=15         # seconds between AI reviews of an open trade (scalper default)
#AI_TIMEOUT_SECONDS=8.0
#AI_MAX_RETRIES=1
AI_CIRCUIT_FAILURES=5
AI_CIRCUIT_COOLDOWN_SECONDS=120

# ── 4c) AI thresholds and what it may change ─────────────────────────────
AI_MIN_CONFIDENCE=0.60          # APPROVE below this becomes WAIT
#AI_ENTRY_APPEAL=true
AI_ENTRY_APPEAL_MIN_CONFIDENCE=0.75
AI_POSITION_MIN_CONFIDENCE=0.60
#AI_POSITION_VOTES=2
AI_EXTEND_MIN_PROGRESS=0.90     # EXTEND only near the target
AI_EXTEND_TP_MULT=1.15          # ...then TP +15%
AI_EXTEND_LOCK_PCT=0.80         # ...and lock 80% of the open profit
AI_REGIME_TTL_SECONDS=14400     # directives expire after 4h -> baseline restored

# ── 4d) v2.3 TWIN-BRAIN SCALPER (all default ON for BOT_PROFILE=scalper) ─
# Analyst AI: reads the chart on its own, keeps a fresh brief per symbol, and
# is compared with the bot's signal the instant it fires:
#   AGREE -> trade now (no AI wait) | CONFLICT -> the bot obeys the AI
#   no / neutral brief -> the per-signal entry gate decides (as in v2.2)
# It costs about 2 AI calls a minute per symbol: with a free tier (e.g. Groq
# 30 req/min) and 4 symbols, add a 2nd/3rd key to AI_API_KEYS or raise
# AI_BRIEF_INTERVAL_SECONDS.
#AI_BRIEF_ENABLED=true
#AI_BRIEF_MODEL=                 # empty = AI_MODEL. A different model = a real 2nd opinion
#AI_BRIEF_INTERVAL_SECONDS=30
# The Analyst can use its OWN provider + keys, so a free tier's daily token cap on
# the entry gate / Guardian is not eaten by it (both must be set; else it shares
# AI_BASE_URL / AI_API_KEYS). Any OpenAI-compatible endpoint works.
#AI_BRIEF_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#AI_BRIEF_API_KEYS=your_brief_key_1,your_brief_key_2
#AI_BRIEF_TTL_SECONDS=90         # a brief older than this is ignored
#AI_BRIEF_AGREE_CONF=0.55
#AI_BRIEF_VETO_CONF=0.65
#AI_BRIEF_FASTLANE=true          # AGREE skips the per-signal AI call
#AI_BRIEF_FLIP_CLOSE=true        # the Analyst turning against an open trade closes it
#AI_BRIEF_FLIP_CONF=0.70
#AI_BRIEF_FLIP_CONFIRMS=2
#
# $ scalping: the lot is sized so the market's TP distance is worth this much.
# 0.01 lot on gold pays ~$1 per $1 move, so $3 means a ~$3 move; on EURUSD
# 0.01 lot pays ~$0.10 per pip, so the bot raises the lot instead (cap below).
#SCALP_SCAN_M1=true             # scalper: also take signals from closed M1 bars (false = M5/M15 only)
#SCALP_USD_MODE=true
#SCALP_TARGET_USD=3.0            # try 2-5
#SCALP_MAX_LOT=1.0
#SCALP_MAX_LOSS_MULT=2.0         # skip when the broker's minimum lot makes the stop > 2x target
#SCALP_MAX_SPREAD_PCT_OF_TARGET=35
#
# Scalp Guard (local, no network, every loop): closes only, never moves a stop.
#SCALP_GUARD_ENABLED=true
#SCALP_STALL_SECONDS=75          # never worked after this long -> out
#SCALP_GIVEBACK_PCT=0.40         # had >=50% of target, gave back 40% -> bank the rest
#SCALP_EARLY_CUT_PCT=0.70        # never worked and 70% of the way to the stop -> cut
#SCALP_MAX_HOLD_SECONDS=240

# ── 5) ALERTS & FEEDS (optional) ────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
NEWS_ENABLED=true               # feeds the AI context + blackout window
# Several RSS feeds, comma-separated, tried in order (default: fxstreet, investinglive,
# investing.com). Set it only if your network blocks all of them.
#NEWS_RSS_URL=https://www.fxstreet.com/rss/news,https://investinglive.com/feed/news

# ── 6) NOT here on purpose ──────────────────────────────────────────────
# Kill switches, session hours, daily loss halt, drawdown halt, margin
# buffer, SL/TP multipliers and the ML model live in config.py and are NOT
# env-tunable, because the AI may never loosen them either (its directive
# whitelist has hard ranges and is tighten-only vs your baseline).
