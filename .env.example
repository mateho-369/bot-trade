# Copy this file to ".env" and fill in your real values.
# The .env file is ignored by git and should never be shared.
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── AI Entry Review (OPTIONAL — OFF by default) ───────────────────────────
# A read-only AI risk-reviewer sits in FRONT of the existing deterministic
# risk checks. It may only APPROVE / REJECT / WAIT a candidate signal. It
# NEVER places/cancels orders, sizes positions, or moves stops. A valid
# APPROVE only lets the candidate continue to the normal risk/order path.
#
# Enabling AI makes AI APPROVAL REQUIRED: while AI is on, a REJECT/WAIT or ANY
# failure (missing key, timeout, invalid reply, rate limit, provider error,
# open circuit) BLOCKS the entry — fail-closed, never silently approved.
# Set AI_ENABLED=false (the default) to trade exactly as before with no
# provider call and no journal. Never weaken a live-account guard to use this.
#
# DEMO / TEST (AI enabled, offline): set AI_ENABLED=true, AI_PROVIDER=
# openai_compat, and point AI_BASE_URL at any OpenAI-compatible endpoint with
# a valid AI_API_KEY + AI_MODEL. The unit tests (verify_ai_entry.py) exercise
# the AI-enabled path fully OFFLINE with a fake provider — no network needed.

AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_RESPONSE_FORMAT=json_object

# ── v2.1: the AI is a REAL participant, not a bolt-on veto ──────────────
# Three independent roles. Each one runs only when its own flag is on AND the
# plumbing (AI_PROVIDER + a key) exists; if a flag is on without a key the bot
# says so in the startup banner instead of trading silently without it.
#   role 1  AI_ENABLED              entry gate   (APPROVE/REJECT/WAIT, fail-CLOSED)
#   role 2  AI_POSITION_ENABLED     position mgr (HOLD/CLOSE/EXTEND, fail-SAFE)
#   role 3  AI_REGIME_ENABLED       bot directives (bounded, clamped, expiring)
AI_POSITION_ENABLED=true
AI_REGIME_ENABLED=true

# The AI runs on its own worker thread (v2.1). A slow, rate-limited or dead
# provider can therefore never freeze break-even / trailing / close-detection
# in the 0.5s loop. Set AI_ASYNC=false only to reproduce the old inline flow.
AI_ASYNC=true
AI_WORKER_THREADS=1
AI_QUEUE_MAX=12
AI_QUEUE_BACKOFF_SECONDS=10
AI_RESULT_TTL_SECONDS=120
AI_ENTRY_MAX_AGE_SECONDS=45
AI_ENTRY_MAX_DRIFT_ATR=0.5
AI_POSITION_MAX_DRIFT_PROGRESS=0.15
AI_REJECT_COOLDOWN_SECONDS=45

# Several keys, comma separated — rotated on rate limit / provider error.
# AI_API_KEYS wins over AI_API_KEY if both are set.
AI_API_KEYS=

# Cost reality (this repo's research, REAL_WORLD_TEST.md): M1 gold scalping at
# Exness spread lost because spread was ~11% of the stop distance; the H1
# engine wins with ~4%. 0 disables the gate (not recommended).
MAX_SPREAD_COST_PCT=18.0
BOT_PROFILE=balanced
ENTRY_ENGINE=SR_H1
